{
  "name": "duoduo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/set-db-provider.mjs && prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:provider": "node scripts/set-db-provider.mjs",
    "db:push": "node scripts/set-db-provider.mjs && prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "gen:secret": "node scripts/gen-secret.mjs",
    "postinstall": "prisma generate",
    "setup": "npm install && npm run db:push && npm run db:seed",
    "verify": "npm run typecheck && npm test && npm run build",
    "docker:up": "docker compose up -d --build",
    "docker:logs": "docker compose logs -f duoduo",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "lucide-react": "^1.57.0",
    "next": "^16.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.25.42",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.29",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.5.0",
    "autoprefixer": "^10.6.1",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.31",
    "prisma": "^6.8.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.1.4"
  },
  "description": "Gamified English and Chinese learning platform for Russian speakers: Next.js 15, Prisma, SM-2 spaced repetition.",
  "license": "MIT",
  "author": "Venius24",
  "homepage": "https://github.com/Venius24/duoduo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Venius24/duoduo.git"
  },
  "bugs": {
    "url": "https://github.com/Venius24/duoduo/issues"
  },
  "keywords": [
    "language-learning",
    "spaced-repetition",
    "sm-2",
    "nextjs",
    "prisma",
    "typescript",
    "gamification"
  ],
  "engines": {
    "node": ">=20"
  }
}
