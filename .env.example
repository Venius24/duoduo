# ─── обязательные ──────────────────────────────────────────────────────────

# SQLite (локально и на своём сервере):
DATABASE_URL="file:./dev.db"
# PostgreSQL (Vercel, Railway, Neon и т.п.) — провайдер схемы переключится сам:
# DATABASE_URL="postgresql://user:pass@host:5432/duoduo?sslmode=require"

# Секрет подписи сессий. Сгенерировать: npm run gen:secret
# В продакшене приложение не стартует без него или с шаблонным значением.
JWT_SECRET="change-me-run-npm-run-gen-secret"

# ─── необязательные ────────────────────────────────────────────────────────

# Явно задать провайдер БД, если автоопределение по DATABASE_URL не подходит.
# DATABASE_PROVIDER="postgresql"

# 1 — всегда ставить флаг Secure на cookie сессии. Нужно, когда TLS
# терминирует прокси и приложение внутри видит обычный http.
# COOKIE_SECURE="0"

# ИИ-объяснение ошибок. Без ключа работают локальные подсказки.
OPENAI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# Показывается в ответе /api/health — удобно для проверки, что выкатилось.
APP_VERSION="1.0.0"
